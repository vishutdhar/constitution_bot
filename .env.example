# ============================================
# Constitution Bot — Environment Variables
# ============================================
# Copy this file to .env and fill in your keys.
# NEVER commit the .env file to git!
# ============================================

# --- X (Twitter) API Credentials ---
# Get these from https://developer.x.com/en/portal/dashboard
# You need a project with "Read and Write" permissions.
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# --- Account (optional) ---
# The X handle shown in post footers. Defaults to USC1787 if unset.
# X_HANDLE=USC1787

# --- Posting mode ---
# Attach the pre-rendered video (video/videos/day_NN.mp4) instead of the image.
# Off by default (image posts). Set to 1/true to enable, or pass --video on the CLI.
# Requires the day's video file to exist at runtime (see video/README.md).
# POST_VIDEO=false

# --- Future Platforms ---
# BLUESKY_HANDLE=yourhandle.bsky.social
# BLUESKY_APP_PASSWORD=your_app_password_here
# THREADS_ACCESS_TOKEN=your_access_token_here
# MASTODON_ACCESS_TOKEN=your_access_token_here
# MASTODON_INSTANCE_URL=https://mastodon.social
